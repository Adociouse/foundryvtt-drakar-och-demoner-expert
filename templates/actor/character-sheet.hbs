<div class="dode-character-sheet-body">
<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" />
  <div class="header-fields">
    <div class="name-row">
      <input class="actor-name" name="name" type="text" value="{{actor.name}}" placeholder="Namn" />
      {{#if isGM}}
        <button type="button" class="wizard-lock-toggle {{#if wizardUnlocked}}is-unlocked{{/if}}" data-action="toggleWizardUnlock"
          title="{{#if wizardUnlocked}}Upplåst för guide-redigering — klicka för att låsa{{else}}Lås upp för guide-redigering (spelaren får redigera en gång){{/if}}">
          <i class="fa-solid {{#if wizardUnlocked}}fa-lock-open{{else}}fa-lock{{/if}}"></i>
        </button>
      {{/if}}
      {{!-- Viloperiodsgrinden — REG s.46. EP kan inte omsättas under ett äventyr. --}}
      {{#if isGM}}
        <button type="button" class="rest-toggle {{#if trainingUnlocked}}is-unlocked{{/if}}" data-action="toggleRest"
          title="{{#if trainingUnlocked}}Viloperiod öppen — träning möjlig. Klicka för att stänga{{else}}Öppna viloperiod (7 dagars vila) så rollpersonen kan träna{{/if}}">
          <i class="fa-solid {{#if trainingUnlocked}}fa-bed{{else}}fa-person-hiking{{/if}}"></i>
        </button>
        <button type="button" data-action="awardBonusEp" title="Dela ut fria bonuspoäng efter äventyret">
          <i class="fa-solid fa-star"></i>
        </button>
        {{!-- Sömnklockan — RP s.63: en färdighet ger EP första gången den lyckas
              efter en sovperiod om minst sex timmar (två för alver). --}}
        <button type="button" data-action="sleep"
          title="Sovperiod — nollställer sömnklockan så färdigheterna kan tjäna EP igen (RP s.63: minst 6 timmar, 2 för alver){{#if usedSinceRest}}. {{usedSinceRest}} färdigheter har gett EP sedan sist{{/if}}">
          <i class="fa-solid fa-moon"></i>{{#if usedSinceRest}} {{usedSinceRest}}{{/if}}
        </button>
      {{/if}}
      {{#if trainingUnlocked}}
        <button type="button" data-action="openTraining" title="Träna färdigheter — tjäna och omsätt EP">
          <i class="fa-solid fa-dumbbell"></i> Träna
        </button>
        {{#if hasMagic}}
          {{!-- Eget fönster: SB s.7 ger magiskolor och besvärjelser andra
                EP-källor än vanliga färdigheter. --}}
          <button type="button" data-action="openMagicTraining" title="Träna magiskolor och besvärjelser">
            <i class="fa-solid fa-wand-sparkles"></i> Magi
          </button>
        {{/if}}
      {{/if}}
      {{#if canEditInWizard}}
        <button type="button" data-action="openWizardEdit" title="Öppna rollpersonen i guiden">
          <i class="fa-solid fa-hat-wizard"></i> Redigera i guiden
        </button>
      {{/if}}
    </div>
    <div class="identity-row">
      <div class="drop-zone" data-item-id="{{race.id}}">
        <span class="drop-label">{{localize "DODE.Actor.Ras"}}</span>
        {{#if race}}
          <a data-action="editItem">{{race.name}}</a>
          <button type="button" data-action="clearRas" title="Ta bort"><i class="fa-solid fa-xmark"></i></button>
        {{else}}
          <span class="drop-hint">{{localize "DODE.Actor.RasDrop"}}</span>
        {{/if}}
      </div>
      <div class="drop-zone" data-item-id="{{profession.id}}">
        <span class="drop-label">{{localize "DODE.Actor.Yrke"}}</span>
        {{#if profession}}
          <a data-action="editItem">{{profession.name}}</a>
          <button type="button" data-action="clearYrke" title="Ta bort"><i class="fa-solid fa-xmark"></i></button>
        {{else}}
          <span class="drop-hint">{{localize "DODE.Actor.YrkeDrop"}}</span>
        {{/if}}
      </div>
      <label>Ålder <input type="text" name="system.alder" value="{{system.alder}}" /></label>
      {{#if system.socialStanding.rank}}
        <span class="social-standing" title="Socialt stånd (RP s.27)">{{system.socialStanding.rank}}</span>
      {{/if}}
    </div>
    <div class="derived-row">
      <span>{{localize "DODE.Derived.KP"}}: <input class="hp-value" type="number" name="system.hp.value" value="{{system.hp.value}}" /> / {{system.hp.max}}</span>
      <span>{{localize "DODE.Derived.Psy"}}: <input class="hp-value" type="number" name="system.resources.psy.value" value="{{system.resources.psy.value}}" /> / {{system.resources.psy.max}}</span>
      <span>{{localize "DODE.Derived.DamageBonus"}}: {{system.damageBonus}}</span>
      <span>{{localize "DODE.Derived.Abs"}}: {{system.abs}}</span>
      <span>{{localize "DODE.Derived.Movement"}}: {{system.movement}}</span>
      <span>{{localize "DODE.Derived.CarryCapacity"}}: {{system.carryCapacity}} kg</span>
      {{#if system.ep.bonusAvailable}}
        <span title="Fria bonuspoäng från spelledaren — inte bundna till någon färdighet">Fria EP: {{system.ep.bonusAvailable}}</span>
      {{/if}}
    </div>
    {{!-- Börsen — vad rollpersonen faktiskt bär. Skild från startCapital, som
          är skapandeögonblickets siffra och aldrig minskar. --}}
    <div class="currency-row" title="{{localize 'DODE.Actor.Currency'}} — totalt {{system.currency.totalSm}} sm">
      <span class="currency-label">{{localize "DODE.Actor.Currency"}}</span>
      <label>gm <input type="number" name="system.currency.gm" value="{{system.currency.gm}}" min="0" /></label>
      <label>sm <input type="number" name="system.currency.sm" value="{{system.currency.sm}}" min="0" /></label>
      <label>km <input type="number" name="system.currency.km" value="{{system.currency.km}}" min="0" /></label>
      <span class="currency-total">= {{system.currency.totalSm}} sm</span>
    </div>
  </div>
</header>

<section class="attributes-grid">
  {{#each attributes as |labelKey key|}}
    <div class="attribute">
      <label>{{localize labelKey}}</label>
      <strong class="attr-total" title="{{localize 'DODE.Actor.Total'}}">{{lookup (lookup ../system.attributes key) "total"}}</strong>
      <span class="attr-bonus" title="{{lookup (lookup ../system.attributes key) "bonusTooltip"}}">{{#if (lookup (lookup ../system.attributes key) "bonus")}}{{lookup (lookup ../system.attributes key) "bonusDisplay"}}{{else}}&nbsp;{{/if}}</span>
      <input type="number" name="system.attributes.{{key}}.value" value="{{lookup (lookup ../system.attributes key) "value"}}" title="{{localize 'DODE.Actor.Base'}}" />
      <span class="group">{{localize "DODE.Skill.Group"}} {{lookup (lookup ../system.attributes key) "group"}}</span>
    </div>
  {{/each}}
</section>

<section class="skills">
  <header class="skills-header">
    <h3>Färdigheter</h3>
    {{!-- SL-låst: färdigheter lärs in genom träning i spel, inte genom att
          spelaren lägger till dem själv. Se #onAddSkill. --}}
    {{#if isGM}}
      <button type="button" data-action="addSkill" title="Dela ut en färdighet efter träning"><i class="fa-solid fa-plus"></i> Dela ut färdighet</button>
      <button type="button" data-action="grantSpell" title="Dela ut en besvärjelse eller välsignelse"><i class="fa-solid fa-wand-sparkles"></i> Dela ut besvärjelse</button>
    {{/if}}
  </header>
  <ol class="skill-list">
    {{#each skills as |skill|}}
      <li class="skill-row" data-item-id="{{skill.id}}">
        <a data-action="editSkill" class="skill-name">{{skill.name}}</a>
        {{#if skill.grantedReason}}<i class="fa-solid fa-graduation-cap granted-mark" title="Utdelad av {{skill.grantedBy}}: {{skill.grantedReason}}"></i>{{/if}}
        {{#if skill.system.bonus}}
          <span class="skill-fv" title="{{localize 'DODE.Actor.Base'}}">FV {{skill.system.fv}}</span>
          <span class="attr-bonus" title="{{localize 'DODE.Actor.Mod'}}">{{skill.system.bonusDisplay}}</span>
          <span class="skill-fv skill-total" title="{{localize 'DODE.Actor.Total'}}">= {{skill.system.total}}</span>
        {{else}}
          <span class="skill-fv">FV {{skill.system.fv}}</span>
        {{/if}}
        {{#if skill.system.ep.awardedSinceRest}}
          {{!-- Har redan gett EP sedan senaste sovperioden (RP s.63). --}}
          <i class="fa-solid fa-moon used-mark" title="Har redan gett EP sedan senaste sovperioden"></i>
        {{/if}}
        {{#if skill.system.ep.available}}
          {{!-- Färdighetens egen EP-pott — bunden hit, kan inte flyttas (REG s.45). --}}
          <span class="skill-ep" title="Intjänad EP, bunden till denna färdighet">&#11045;{{skill.system.ep.available}}</span>
        {{/if}}
        <button type="button" data-action="rollSkill" title="Slå"><i class="fa-solid fa-dice-d20"></i></button>
        <button type="button" data-action="deleteSkill" title="Ta bort"><i class="fa-solid fa-trash"></i></button>
      </li>
    {{else}}
      <li class="skill-row-empty">Inga färdigheter ännu.</li>
    {{/each}}
  </ol>
</section>

<section class="special-abilities">
  <header class="skills-header">
    <h3>Särskilda förmågor</h3>
    <button type="button" data-action="rollAbility" title="Slå 2T20+BP mot RP s.25-27:s tabell"><i class="fa-solid fa-dice-d20"></i> Slå fram förmåga</button>
    <button type="button" data-action="addAbility"><i class="fa-solid fa-plus"></i> Ny förmåga</button>
  </header>
  <ol class="skill-list">
    {{#each system.specialAbilities as |ability i|}}
      <li class="skill-row ability-row" data-index="{{i}}">
        <input type="text" name="system.specialAbilities.{{i}}.name" value="{{ability.name}}" placeholder="Namn" class="skill-name" />
        <input type="text" name="system.specialAbilities.{{i}}.description" value="{{ability.description}}" placeholder="Beskrivning" class="ability-description" />
        <button type="button" data-action="deleteAbility" title="Ta bort"><i class="fa-solid fa-trash"></i></button>
      </li>
    {{else}}
      <li class="skill-row-empty">Inga särskilda förmågor ännu.</li>
    {{/each}}
  </ol>

  {{#if formagor.length}}
    <h4 class="formaga-item-heading">Förmågor med effekter</h4>
    <ol class="skill-list">
      {{#each formagor as |formaga|}}
        <li class="skill-row" data-item-id="{{formaga.id}}">
          <a data-action="editItem" class="skill-name">{{formaga.name}}</a>
          {{#if formaga.system.origin}}<span class="skill-fv">{{formaga.system.origin}}</span>{{/if}}
          <button type="button" data-action="deleteItem" title="Ta bort"><i class="fa-solid fa-trash"></i></button>
        </li>
      {{/each}}
    </ol>
  {{/if}}
</section>

{{#if minimagi}}
{{!-- Minibesvärjelser — HÄRLEDDA ur rollpersonens magiskolor, inte ägda poster.
      MAG s.23: minimagin följer med skolan, behöver inte stå i formelsamlingen
      och lyckas alltid. En magiker med flera skolor har alla skolornas minimagi. --}}
<section class="minimagi">
  <header class="skills-header">
    <h3>Minibesvärjelser</h3>
    <span class="minimagi-source" title="Följer automatiskt med magiskolorna — inga poster att äga">
      {{minimagi.schoolNames}}
    </span>
  </header>
  <p class="section-hint">Lyckas alltid — ingen CL-kontroll. Kostar 1 PSY och är
     alltid Kvick (MAG s.23).</p>
  <ol class="skill-list">
    {{#each minimagi.entries as |mini|}}
      <li class="skill-row minimagi-row">
        <img class="minimagi-img" src="{{mini.img}}" alt="" />
        <span class="skill-name">{{mini.name}}</span>
        <span class="minimagi-school">{{mini.schoolLabel}}</span>
        <span class="minimagi-gestures" title="Åthävor vid FV {{mini.fv}} i skolan (MAG s.23)">{{mini.gestures}}</span>
        {{#if mini.isGranted}}<i class="fa-solid fa-gift granted-mark" title="Utdelad av spelledaren"></i>{{/if}}
        <span class="skill-fv">{{mini.psyCost}} PSY</span>
      </li>
    {{/each}}
  </ol>
</section>
{{/if}}

<section class="gear">
  <header class="skills-header">
    <h3>{{localize "DODE.Actor.Utrustning"}}</h3>
  </header>
  <ol class="skill-list">
    {{#each gear as |entry|}}
      <li class="skill-row" data-item-id="{{entry.item.id}}">
        <a data-action="editItem" class="skill-name">{{entry.item.name}}</a>
        {{#if entry.isVapen}}
          <span class="skill-fv">{{entry.item.system.damage}}</span>
          <button type="button" data-action="rollDamage" title="Slå skada"><i class="fa-solid fa-burst"></i></button>
        {{else if entry.isRustning}}
          <span class="skill-fv">Abs {{entry.item.system.abs}}</span>
        {{else if entry.isBesvarjelse}}
          <span class="fv-input">E <input type="number" class="effektgrad-input" data-effektgrad value="1" min="1" /></span>
          <button type="button" data-action="castSpell" title="Kasta"><i class="fa-solid fa-hand-sparkles"></i></button>
        {{else if entry.isUtrustning}}
          {{#if entry.item.system.quantity}}<span class="skill-fv">{{entry.item.system.quantity}} st</span>{{/if}}
          <span class="skill-fv" title="{{localize 'DODE.Equipment.TotalWeight'}}">{{entry.item.system.totalWeight}} BEP</span>
          <span class="skill-fv" title="{{localize 'DODE.Equipment.PriceSmHint'}}">{{entry.item.system.priceDisplay}}</span>
        {{/if}}
        {{#if entry.canEquip}}
          <button type="button" data-action="toggleEquipped"
            class="equip-toggle {{#if entry.item.system.equipped}}is-equipped{{/if}}"
            title="{{#if entry.item.system.equipped}}Utrustad — klicka för att ta av{{else}}Ej utrustad — klicka för att utrusta{{/if}}">
            <i class="fa-solid {{#if entry.item.system.equipped}}fa-shield{{else}}fa-shield-halved{{/if}}"></i>
          </button>
        {{/if}}
        <button type="button" data-action="deleteItem" title="Ta bort"><i class="fa-solid fa-trash"></i></button>
      </li>
    {{else}}
      <li class="skill-row-empty">Ingen utrustning ännu — dra hit vapen, rustning eller besvärjelser från ett kompendium.</li>
    {{/each}}
  </ol>
</section>

<section class="biography">
  <label class="life-goal-field">Livsmål
    <input type="text" name="system.lifeGoal" value="{{system.lifeGoal}}" placeholder="T.ex. Berömmelse, Kunskap, Rikedom..." />
  </label>
  {{editor system.biography target="system.biography" button=true engine="prosemirror"}}
</section>
</div>
