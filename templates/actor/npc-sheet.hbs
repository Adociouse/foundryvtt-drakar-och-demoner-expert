<div class="dode-npc-sheet-body">
{{!-- ⚠ Icke-SL ser BARA namn/bild + plundringslistan nedan — se
      actor-npc-sheet.mjs's `isGM`-kommentar för varför (Observer-behörighet
      krävs för att plundringsdata ska nå klienten alls, men Foundry har
      ingen fältgranulär behörighet, så resten av arket — anfallsdata,
      attribut, Speciellt/Beskrivning, som ofta bär SL-hemligheter — döljs
      HÄR i mallen i stället). --}}
<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" {{#if isGM}}data-action="editImage" data-edit="img"{{/if}} title="{{actor.name}}" />
  <div class="header-fields">
    {{#if isGM}}
      <input class="actor-name" name="name" type="text" value="{{actor.name}}" placeholder="Namn" />
    {{else}}
      <h2 class="actor-name-readonly">{{actor.name}}</h2>
    {{/if}}
    {{#if isGM}}
    <div class="derived-row">
      <span>{{localize "DODE.Derived.KP"}}: <input class="hp-value" type="number" name="system.hp.value" value="{{system.hp.value}}" /> / {{system.hp.max}}</span>
      <span>{{localize "DODE.Derived.Psy"}}: <input class="psy-value" type="number" name="system.resources.psy.value" value="{{system.resources.psy.value}}" /> / {{system.resources.psy.max}}</span>
      <span>ABS <input type="number" name="system.abs" value="{{system.abs}}" min="0" /></span>
      <span>SB <input type="text" name="system.damageBonus" value="{{system.damageBonus}}" /></span>
      <span>Förfl. <input type="text" name="system.movement" value="{{system.movement}}" /></span>
      <span>Moral <input type="number" name="system.moral" value="{{system.moral}}" /></span>
    </div>
    <div class="derived-row">
      <span>Antal <input type="text" name="system.count" value="{{system.count}}" /></span>
      <span>Hemvist <input type="text" name="system.habitat" value="{{system.habitat}}" /></span>
      <span>Vanlighet <input type="text" name="system.rarity" value="{{system.rarity}}" /></span>
    </div>
    {{/if}}
  </div>
</header>

{{#if isGM}}
<section class="attributes-grid">
  {{#each attributes as |labelKey key|}}
    <div class="attribute">
      <label>{{localize labelKey}}</label>
      <input type="number" name="system.attributes.{{key}}.value" value="{{lookup (lookup ../system.attributes key) "value"}}" />
      <span class="group">{{localize "DODE.Skill.Group"}} {{lookup (lookup ../system.attributes key) "group"}}</span>
    </div>
  {{/each}}
</section>

<section class="attacks">
  <header class="skills-header">
    <h3>Anfall</h3>
    <button type="button" data-action="addAttack"><i class="fa-solid fa-plus"></i> Nytt anfall</button>
  </header>
  <ol class="skill-list">
    {{#each system.attacks as |attack index|}}
      <li class="skill-row" data-attack-index="{{index}}">
        <input type="text" name="system.attacks.{{index}}.name" value="{{attack.name}}" placeholder="Namn" />
        <span class="fv-input">FV <input type="number" name="system.attacks.{{index}}.fv" value="{{attack.fv}}" /></span>
        <input type="text" name="system.attacks.{{index}}.damage" value="{{attack.damage}}" placeholder="Skada" />
        <input type="text" name="system.attacks.{{index}}.note" value="{{attack.note}}" placeholder="Notering" />
        <button type="button" data-action="rollAttack" title="Slå anfall"><i class="fa-solid fa-dice-d20"></i></button>
        <button type="button" data-action="rollAttackDamage" title="Slå skada"><i class="fa-solid fa-burst"></i></button>
        <button type="button" data-action="declareAttack" title="Anfall (detaljerad strid)"><i class="fa-solid fa-crosshairs"></i></button>
        <button type="button" data-action="deleteAttack" title="Ta bort"><i class="fa-solid fa-trash"></i></button>
      </li>
    {{else}}
      <li class="skill-row-empty">Inga anfall ännu.</li>
    {{/each}}
  </ol>
</section>
{{/if}}

<section class="gear">
  <header class="skills-header">
    <h3>{{localize "DODE.Actor.Utrustning"}}</h3>
  </header>
  <ol class="skill-list">
    {{#each gear as |entry|}}
      <li class="skill-row {{#if entry.isNatural}}natural-item{{else}}draggable{{/if}}" data-item-id="{{entry.item.id}}">
        <a data-action="editItem" class="skill-name">{{entry.item.name}}</a>
        {{#if entry.isNatural}}
          <i class="fa-solid fa-paw" title="Naturligt — inte plockbart/lootbart"></i>
        {{/if}}
        {{#if entry.isVapen}}
          <span class="skill-fv">{{entry.item.system.damage}}</span>
          {{#if ../isGM}}<button type="button" data-action="declareAttack" title="Anfall (detaljerad strid)"><i class="fa-solid fa-crosshairs"></i></button>{{/if}}
        {{else if entry.isRustning}}
          <span class="skill-fv">Abs {{entry.item.system.abs}}</span>
        {{else if entry.isUtrustning}}
          {{#if entry.item.system.quantity}}<span class="skill-fv">{{entry.item.system.quantity}} st</span>{{/if}}
        {{/if}}
        {{#if ../isGM}}
          {{#if entry.canEquip}}
            <button type="button" data-action="toggleEquipped"
              class="equip-toggle {{#if entry.item.system.equipped}}is-equipped{{/if}}"
              title="{{#if entry.item.system.equipped}}Utrustad — klicka för att ta av{{else}}Ej utrustad — klicka för att utrusta{{/if}}">
              <i class="fa-solid {{#if entry.item.system.equipped}}fa-shield{{else}}fa-shield-halved{{/if}}"></i>
            </button>
          {{/if}}
        {{/if}}
        {{#unless entry.isNatural}}
          <button type="button" data-action="requestLoot" title="Plundra till din rollperson"><i class="fa-solid fa-sack-dollar"></i></button>
        {{/unless}}
        {{#if ../isGM}}<button type="button" data-action="deleteItem" title="Ta bort"><i class="fa-solid fa-trash"></i></button>{{/if}}
      </li>
    {{else}}
      <li class="skill-row-empty">Ingen utrustning ännu — dra hit vapen, rustning eller utrustning från ett kompendium.</li>
    {{/each}}
  </ol>
</section>

{{#if isGM}}
<section class="npc-fields">
  <label>Färdigheter (fritext) <input type="text" name="system.skills" value="{{system.skills}}" /></label>
</section>

<section class="npc-special">
  <h3>Speciellt</h3>
  {{editor system.special target="system.special" button=true engine="prosemirror"}}
  <h3>Beskrivning</h3>
  {{editor system.biography target="system.biography" button=true engine="prosemirror"}}
</section>
{{/if}}
</div>
