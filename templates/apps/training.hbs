<div class="dode-training-body">
  {{#unless unlocked}}
    <div class="training-locked">
      <i class="fa-solid fa-lock"></i>
      <div>
        <strong>Viloperioden är inte öppnad.</strong>
        <p>Det går inte att träna under ett pågående äventyr, och EP kan bara
           omsättas efter minst 7 dagars sammanhängande vila (REG s.45–46).
           Spelledaren öppnar grinden från rollpersonsarket.</p>
      </div>
    </div>
  {{/unless}}

  <header class="training-header">
    {{!-- REG s.45: ensamträning ger ett veckoslag, träning med lärare två.
          Det är hela den mekaniska vinsten med att betala. --}}
    <div class="training-mode">
      <button type="button" data-action="setMode" data-mode="ensam"
        class="{{#unless isTeacher}}is-active{{/unless}}" title="Ett veckoslag, ingen avgift">
        Ensamträning
      </button>
      <button type="button" data-action="setMode" data-mode="larare"
        class="{{#if isTeacher}}is-active{{/if}}" title="Två veckoslag mot avgift">
        Med lärare
      </button>
      <span class="mode-summary">
        {{rollsPerWeek}} slag/vecka{{#if fee}} · {{fee}} sm{{/if}}
      </span>
    </div>
    <div class="training-wallet">
      <span title="Fria bonuspoäng — inte bundna till någon färdighet (REG s.46)">
        <i class="fa-solid fa-star"></i> Fria EP: <strong>{{bonusAvailable}}</strong>
      </span>
      <span class="purse {{#unless canAffordFee}}is-short{{/unless}}" title="Börs">
        <i class="fa-solid fa-coins"></i> {{purse}}
      </span>
    </div>
  </header>

  {{#*inline "trainingRows"}}
    <ol class="training-list">
      {{#each rows as |row|}}
        <li class="training-row" data-item-id="{{row.id}}">
          <img src="{{row.img}}" alt="" />
          <div class="training-label">
            <span class="name">{{row.label}}</span>
            {{#if row.note}}<span class="note">{{row.note}}</span>{{/if}}
            {{#if row.trainNote}}<span class="note warn">{{row.trainNote}}</span>{{/if}}
          </div>
          {{!-- Träna = TJÄNAR EP (veckoslag mot grundegenskapen).
                Höj = SPENDERAR EP. Två helt skilda handlingar. --}}
          <span class="training-attr" title="Veckoslaget går mot färdighetens grundegenskap (REG s.45)">
            {{row.attrLabel}} {{row.attrValue}}
          </span>
          <button type="button" data-action="train" {{#unless row.canTrain}}disabled{{/unless}}
            title="Träna en vecka — slår mot {{row.attrLabel}} för att tjäna EP">
            <i class="fa-solid fa-dice-d20"></i> Träna
          </button>
          <span class="training-step">{{row.current}} &rarr; {{row.next}}</span>
          <span class="training-cost" title="EP-kostnad för steget">{{row.cost}} EP</span>
          <span class="training-funding">
            {{#if row.canUseOwn}}
              <span title="Färdighetens egen pott — intjänad i spel eller genom träning">⬥{{row.own}}</span>
            {{/if}}
            {{#if row.bonusNeeded}}<span title="Tas ur de fria bonuspoängen">+{{row.bonusNeeded}} fria</span>{{/if}}
          </span>
          <button type="button" data-action="buy" {{#unless row.affordable}}disabled{{/unless}}
            title="Väx in EP mot ett steg">Höj</button>
        </li>
      {{else}}
        <li class="skill-row-empty">{{emptyText}}</li>
      {{/each}}
    </ol>
  {{/inline}}

  <section class="training-section">
    <h3>Färdigheter</h3>
    {{!-- REG s.45: träning kan inte höja FV över grundegenskapens värde.
          Kategori B och lärdomsfärdigheter är undantagna. --}}
    <p class="section-hint">Träning kan inte höja FV över färdighetens
       grundegenskap. Kategori B och lärdomsfärdigheter är undantagna (REG s.45).</p>
    {{> trainingRows rows=skills emptyText="Inga färdigheter."}}
  </section>

  {{#if schools.length}}
    <section class="training-section">
      <h3>Magiskolor</h3>
      {{!-- MAG s.23: skolans FV höjs BARA genom träning, aldrig av äventyrs-EP. --}}
      <p class="section-hint">Skolans FV höjs bara genom träning — aldrig av EP
         intjänad under äventyr. En helt ny skola kräver lärare och delas ut av
         spelledaren (MAG s.23).</p>
      {{> trainingRows rows=schools emptyText="Inga magiskolor."}}
    </section>
  {{/if}}

  {{#if spells.length}}
    <section class="training-section">
      <h3>Besvärjelser</h3>
      {{!-- MAG: "Man kan inte lära sig en besvärjelse genom ensamträning, utan
            enbart genom träning med lärare." --}}
      <p class="section-hint">Besvärjelser kan bara tränas med lärare, aldrig på
         egen hand (MAG). Kostnaden per S-steg följer magikerns FV i skolan, medan
         multipeln följer besvärjelsens eget S (MAG s.13).</p>
      {{> trainingRows rows=spells emptyText="Inga besvärjelser."}}
    </section>
  {{/if}}
</div>
