{{!-- Stridskort — SLB s.31:s flöde, uppifrån och ned i samma ordning som
      diagrammet: CL → anfallsslag → pareringsslag → träffområde → skada. --}}
<div class="dode-attack-card {{cssClass}}">
  <header class="attack-header">
    <img src="{{weaponImg}}" alt="" />
    <div>
      <strong>{{attackerName}}</strong>{{#if targetName}} <i class="fa-solid fa-arrow-right target-arrow"></i> <strong class="target-name">{{targetName}}</strong>{{/if}}
      <span class="weapon">{{weaponName}}{{#if aimed}} — {{localize "DODE.Chat.AimedAt" location=locationLabel}}{{/if}}</span>
    </div>
    {{#if intentBedova}}<i class="fa-solid fa-hand-fist" title="{{localize 'DODE.Chat.NonLethalIntent'}}"></i>{{/if}}
  </header>

  {{#if targetWarning}}
    <div class="target-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{targetWarning}}</div>
  {{/if}}

  {{!-- Spelar-anfall-planen, 2026-08-21: en spelare utan skrivbehörighet på
        målet får kortet postat DIREKT (riktiga tärningar, redan uträknat)
        men markerat väntande — SL:s Godkänn skriver bara undan det redan
        beräknade resultatet, rullar inget om. Se dode.mjs's
        renderChatMessageHTML-hook för klicklogiken; den manipulerar den
        här blocken direkt i DOM:en (och sparar om `content`) i stället för
        att rendera om hela kortet. --}}
  {{#if pendingBanner}}
    <div class="pending-banner">
      <i class="fa-solid fa-hourglass-half"></i> {{localize "DODE.Chat.PendingGmApproval"}}
    </div>
    <div class="pending-actions">
      <button type="button" data-action="approveAttackRequest"><i class="fa-solid fa-check"></i> {{localize "DODE.Chat.Approve"}}</button>
      <button type="button" data-action="rejectAttackRequest"><i class="fa-solid fa-xmark"></i> {{localize "DODE.Chat.Reject"}}</button>
    </div>
  {{/if}}

  {{!-- CL-uppdelningen: bas + varje modifikation, så bordet ser varför. --}}
  <div class="cl-line" title="Chans att lyckas">
    CL <strong>{{fv}}</strong>
    {{#if clParts.length}}
      <span class="cl-parts">
        ({{base}}{{#each clParts}} {{#if this.positive}}+{{/if}}{{this.value}} {{this.label}}{{/each}})
      </span>
    {{/if}}
    {{#if targetMoving}}<span class="cl-parts" title="SB s.33">— målet sprang/flög, basen redan halverad</span>{{/if}}
  </div>

  <div class="roll-line role-attack">
    <span class="label">{{localize "DODE.Chat.Label.Attack"}}</span>
    <span class="d20 {{attackOutcome}}">{{attackRoll}}</span>
    <span class="outcome {{attackOutcome}}">{{attackOutcomeLabel}}</span>
  </div>
  {{!-- EP-streck för anfallsslaget — RP s.63: en lyckad användning av
        färdigheten ger EP oavsett vad striden sedan blir av det. --}}
  {{#if attackEp}}
    <div class="ep-tick-line"><i class="fa-solid fa-check"></i> +{{attackEp.amount}} EP → {{attackEp.skillName}}</div>
  {{/if}}

  {{!-- Kättingvapen/Piska (SB s.33): eget anfallsslag 18-20 tvingar fram ett
        självfummelslag oavsett vad huvudslaget annars visade. --}}
  {{#if hardParrySelfFumble}}
    <div class="roll-line self-fumble-check">
      <span class="label">{{localize "DODE.Chat.Label.SelfFumbleCheck"}}</span>
      <span class="d20 {{#if hardParrySelfFumble.fumbled}}fummel{{else}}lyckat{{/if}}">{{hardParrySelfFumble.roll}}</span>
      <span class="outcome">{{#if hardParrySelfFumble.fumbled}}{{localize "DODE.Chat.Outcome.Fumbled"}}{{else}}{{localize "DODE.Chat.Outcome.JustMiss"}}{{/if}}</span>
    </div>
  {{/if}}

  {{#if hasParry}}
    <div class="roll-line role-parry">
      <span class="label">{{localize "DODE.Chat.Label.Parry"}}</span>
      <span class="d20 {{parryOutcome}}">{{parryRoll}}</span>
      <span class="outcome {{parryOutcome}}">{{parryOutcomeLabel}}</span>
      <span class="via">{{parryItemName}}</span>
    </div>
    {{#if parryEp}}
      <div class="ep-tick-line"><i class="fa-solid fa-check"></i> +{{parryEp.amount}} EP → {{parryEp.skillName}}</div>
    {{/if}}
  {{else if ranged}}
    <div class="roll-line muted">{{localize "DODE.Chat.NoParryRanged"}}</div>
  {{/if}}

  {{#if cleanKnockout}}
    {{!-- Avsteg: perfekt + bedövande + riktat huvudslag. Noll skada, inget spår. --}}
    <div class="clean-knockout">
      <i class="fa-solid fa-moon"></i> {{cleanKnockout.text}}
    </div>
  {{else if wear}}
    <div class="wear-line">
      <i class="fa-solid fa-shield-halved"></i>
      {{localize "DODE.Chat.WearDamage" item=wear.item damage=wear.damage bv=wear.bv}}
      {{#if wear.worn}}{{localize "DODE.Chat.WearNewBv" bv=wear.bvAfter}}{{else}}{{localize "DODE.Chat.WearHolds"}}{{/if}}
      {{#if wear.broke}}<strong>{{localize "DODE.Chat.WearBroken"}}</strong>{{/if}}
    </div>
  {{/if}}

  {{#if damage}}
    <div class="damage-line">
      <span class="location">{{locationLabel}}</span>
      <span class="dmg">{{damage.rolled}}{{#if damage.maximised}} (max){{/if}}</span>
      {{#if damage.abs}}<span class="abs">{{localize "DODE.Chat.DamageAbs" abs=damage.abs}}</span>{{/if}}
      {{#if damage.resistanceBlocked}}<span class="abs">{{localize "DODE.Chat.DamageImmune"}}</span>{{/if}}
      {{#if damage.resistanceReduction}}<span class="abs">{{localize "DODE.Chat.DamageResistance" reduction=damage.resistanceReduction}}</span>{{/if}}
      {{#if damage.resistanceHalved}}<span class="abs">{{localize "DODE.Chat.DamageHalved"}}</span>{{/if}}
      {{#if damage.resistanceDoubled}}<span class="abs">{{localize "DODE.Chat.DamageDoubled"}}</span>{{/if}}
      <strong class="applied">{{damage.applied}} KP</strong>
    </div>
    <div class="total-line">{{localize "DODE.Chat.TotalHpLeft"}} <strong>{{totalAfter}}</strong>{{#if pulled}} <em>({{localize "DODE.Chat.DamagePulled"}})</em>{{/if}}</div>
  {{/if}}

  {{#if effect}}
    <div class="effect-line {{effect.level}}">
      <i class="fa-solid fa-triangle-exclamation"></i> {{effect.text}}
    </div>
  {{/if}}

  {{#if verdictNote}}<div class="verdict-note">{{verdictNote}}</div>{{/if}}

  {{#if fummelDraw}}
    <div class="effect-line kritisk">
      <i class="fa-solid fa-triangle-exclamation"></i> {{localize "DODE.Chat.FumbleTable"}} <strong>{{fummelDraw.primaryName}}</strong>. {{fummelDraw.primaryText}}
      {{#each fummelDraw.extra}}<br />+ <strong>{{this.name}}</strong>. {{this.text}}{{/each}}
    </div>
  {{/if}}
</div>
