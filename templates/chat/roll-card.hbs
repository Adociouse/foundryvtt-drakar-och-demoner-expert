<div class="dode-roll-card {{cssClass}}">
  <header class="roll-card-header">
    <strong>{{label}}</strong> — FV {{fv}}
  </header>
  <div class="roll-card-result">
    <span class="d20-result">{{result}}</span>
    <span class="outcome-label">{{outcomeLabel}}</span>
  </div>
  {{!-- EP tilldelas AUTOMATISKT vid första lyckade användningen efter en
        sovperiod (RP s.63). Ingen knapp och ingen SL-bedömning — sömnklockan
        avgör, och nollas när rollpersonen sovit. --}}
  {{#if epAmount}}
    <footer class="roll-card-ep">
      <i class="fa-solid fa-star"></i>
      +{{epAmount}} EP → {{epItemName}}{{#if epIsPerfekt}} <em>(perfekt: 1T3+1)</em>{{/if}}
    </footer>
  {{/if}}
</div>
