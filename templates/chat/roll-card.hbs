<div class="dode-roll-card {{cssClass}}">
  <header class="roll-card-header">
    <strong>{{label}}</strong> — FV {{fv}}
  </header>
  <div class="roll-card-result">
    <span class="d20-result">{{result}}</span>
    <span class="outcome-label">{{outcomeLabel}}</span>
  </div>
  {{!-- EP-streck. Visas bara för SL: REG s.45 ger EP endast "i ett stressigt
        läge (SL bedömer)", så utdelningen måste vara ett beslut, inte en
        automatisk följd av att slaget lyckades. --}}
  {{#if canAwardEp}}
    <footer class="roll-card-ep">
      <button type="button" data-dode-award-ep>
        <i class="fa-solid fa-star"></i>
        {{#if epIsPerfekt}}Perfekt — dela ut 1T3+1 EP{{else}}Stressigt läge — dela ut 1 EP{{/if}}
      </button>
    </footer>
  {{/if}}
</div>
