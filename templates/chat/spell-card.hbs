{{!-- Besvärjelsekort — mirror av attack-card.hbs:s struktur/CSS (samma
      .dode-attack-card-klass återanvänds för de delade rollLine/d20/outcome-
      reglerna i dode.css; .dode-spell-card är bara en hook för framtida
      besvärjelsespecifik styling, ingen duplicerad CSS än). --}}
<div class="dode-attack-card dode-spell-card {{cssClass}}">
  <header class="attack-header">
    <img src="{{spellImg}}" alt="" />
    <div>
      <strong>{{casterName}}</strong>{{#if targetName}} <i class="fa-solid fa-arrow-right target-arrow"></i> <strong class="target-name">{{targetName}}</strong>{{/if}}
      <span class="weapon">{{spellName}} (E{{E}}) — {{school}}</span>
    </div>
  </header>

  {{#if pendingBanner}}
    <div class="pending-banner">
      <i class="fa-solid fa-hourglass-half"></i> {{localize "DODE.Chat.PendingGmApproval"}}
    </div>
    <div class="pending-actions">
      <button type="button" data-action="approveSpellRequest"><i class="fa-solid fa-check"></i> {{localize "DODE.Chat.Approve"}}</button>
      <button type="button" data-action="rejectSpellRequest"><i class="fa-solid fa-xmark"></i> {{localize "DODE.Chat.Reject"}}</button>
    </div>
  {{/if}}

  <div class="cl-line" title="Chans att lyckas">CL <strong>{{cl}}</strong></div>

  <div class="roll-line">
    <span class="label">{{localize "DODE.Chat.Label.Cast"}}</span>
    <span class="d20 {{castOutcome}}">{{castRoll}}</span>
    <span class="outcome {{castOutcome}}">{{castOutcomeLabel}}</span>
  </div>

  {{#if psyCost}}<div class="ep-tick-line">−{{psyCost}} PSY</div>{{/if}}
  {{#if snedtandning}}
    <div class="effect-line kritisk">
      <i class="fa-solid fa-triangle-exclamation"></i> {{localize "DODE.Chat.MishapPrefix"}} <strong>{{snedtandning.name}}</strong>. {{snedtandning.description}}
      {{#if snedtandning.fobiName}}<br />{{localize "DODE.Chat.PhobiaPrefix"}} <strong>{{snedtandning.fobiName}}</strong>. {{snedtandning.fobiDescription}}{{/if}}
    </div>
  {{else if fumbled}}
    <div class="verdict-note">{{localize "DODE.Chat.MishapTableNotFound"}}</div>
  {{/if}}

  {{#each targets}}
    {{#if this.targetWarning}}
      <div class="target-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{this.targetWarning}}</div>
    {{/if}}
    <div class="damage-line spell-target">
      <span class="location">{{this.name}}</span>
      {{#if this.resisted}}
        <span class="outcome {{#if this.resisted.success}}lyckat{{else}}misslyckat{{/if}}">
          {{#if this.resisted.autoResult}}{{this.resisted.autoResult}}{{else}}{{this.resisted.rolled}}{{/if}}
          {{#if this.resisted.success}}{{localize "DODE.Chat.Resisted"}}{{else}}{{localize "DODE.Chat.ResistedFail"}}{{/if}}
        </span>
      {{/if}}
    </div>
    {{#if this.instantEffect}}
      <div class="damage-line">
        <span class="label">{{#if (eq this.instantEffect.kind "heal")}}{{localize "DODE.Chat.Label.Heal"}}{{else}}{{localize "DODE.Chat.Label.Damage"}}{{/if}}</span>
        <span class="dmg">{{this.instantEffect.rolled}}{{#if this.instantEffect.maximised}} (max){{/if}}</span>
        {{#if this.instantEffect.blocked}}
          <span class="abs">{{localize "DODE.Chat.DamageImmuneShort"}}</span>
        {{else}}
          {{#if this.instantEffect.reduction}}<span class="abs">{{localize "DODE.Chat.DamageResistance" reduction=this.instantEffect.reduction}}</span>{{/if}}
          {{#if this.instantEffect.halved}}<span class="abs">{{localize "DODE.Chat.SpellHalved"}}</span>{{/if}}
          {{#if this.instantEffect.doubled}}<span class="abs">{{localize "DODE.Chat.DamageDoubled"}}</span>{{/if}}
          <strong class="applied">{{this.instantEffect.applied}} {{#if (eq this.instantEffect.resource "psy")}}PSY{{else}}KP{{/if}} {{#if (eq this.instantEffect.kind "heal")}}{{localize "DODE.Chat.Healed"}}{{else}}{{localize "DODE.Chat.Damaged"}}{{/if}}</strong>
        {{/if}}
      </div>
      {{#unless this.instantEffect.blocked}}
        <div class="total-line">{{localize "DODE.Chat.TotalResourcePrefix"}} {{#if (eq this.instantEffect.resource "psy")}}PSY{{else}}KP{{/if}} {{localize "DODE.Chat.TotalResourceSuffix"}} <strong>{{this.instantEffect.totalAfter}}</strong></div>
      {{/unless}}
    {{/if}}
    {{#if this.statusApplied}}<div class="wear-line"><i class="fa-solid fa-circle-exclamation"></i> {{this.statusApplied}}</div>{{/if}}
    {{#if this.weaponEnchantApplies}}<div class="wear-line"><i class="fa-solid fa-wand-sparkles"></i> {{localize "DODE.Chat.EnchantsWeapon" weapon=this.weaponName}}</div>{{/if}}
    {{#if this.skillEffectApplies}}<div class="wear-line"><i class="fa-solid fa-arrow-up-right-dots"></i> {{localize "DODE.Chat.SkillBoost"}}</div>{{/if}}
    {{#if this.fearDraw}}<div class="effect-line kritisk"><i class="fa-solid fa-face-flushed"></i> {{this.fearDraw.text}}</div>{{/if}}
  {{/each}}
</div>
